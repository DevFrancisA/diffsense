{
  "scenarios": [
    {
      "title": "1. Generate Playwright plan button disabled when API is not ready",
      "purpose": "Verify that the 'Generate Playwright plan' button is disabled if the review API is not ready, even if diff or pullRequestUrl inputs are present.",
      "steps": [
        {
          "action": "goto",
          "selector": "",
          "value": "/",
          "expected": ""
        },
        {
          "action": "fill",
          "selector": "#pr-url",
          "value": "https://github.com/owner/repo",
          "expected": ""
        },
        {
          "action": "fill",
          "selector": "textarea[aria-label=\"Unified diff\"]",
          "value": "some diff data",
          "expected": ""
        },
        {
          "action": "expectDisabled",
          "selector": "button.text-button.evaluation-link",
          "value": "",
          "expected": ""
        }
      ]
    },
    {
      "title": "2. Generate Playwright plan button disabled with empty diff and URL when API is not ready",
      "purpose": "Ensure the 'Generate Playwright plan' button is disabled when both diff and pull request URL fields are empty and the API is not ready.",
      "steps": [
        {
          "action": "goto",
          "selector": "",
          "value": "/",
          "expected": ""
        },
        {
          "action": "fill",
          "selector": "#pr-url",
          "value": "",
          "expected": ""
        },
        {
          "action": "fill",
          "selector": "textarea[aria-label=\"Unified diff\"]",
          "value": "",
          "expected": ""
        },
        {
          "action": "expectDisabled",
          "selector": "button.text-button.evaluation-link",
          "value": "",
          "expected": ""
        }
      ]
    },
    {
      "title": "3. Generate Playwright plan button enabled conditions without API readiness do not enable button",
      "purpose": "Confirm that even with diff or pullRequestUrl filled, the 'Generate Playwright plan' button is disabled if apiReady is false or null.",
      "steps": [
        {
          "action": "goto",
          "selector": "",
          "value": "/",
          "expected": ""
        },
        {
          "action": "fill",
          "selector": "#pr-url",
          "value": "https://github.com/owner/repo",
          "expected": ""
        },
        {
          "action": "expectDisabled",
          "selector": "button.text-button.evaluation-link",
          "value": "",
          "expected": ""
        },
        {
          "action": "fill",
          "selector": "textarea[aria-label=\"Unified diff\"]",
          "value": "some diff data",
          "expected": ""
        },
        {
          "action": "expectDisabled",
          "selector": "button.text-button.evaluation-link",
          "value": "",
          "expected": ""
        }
      ]
    },
    {
      "title": "4. Page shows 'Setup required' connection pill when API is not ready",
      "purpose": "Verify that the connection pill on the top bar displays 'Setup required' when the review API readiness is false.",
      "steps": [
        {
          "action": "goto",
          "selector": "",
          "value": "/",
          "expected": ""
        },
        {
          "action": "expectText",
          "selector": "span.connection-pill.disconnected",
          "value": "",
          "expected": "Setup required"
        }
      ]
    },
    {
      "title": "5. Setup inline hint and buttons disabled when API not ready",
      "purpose": "Check that the setup inline message is visible and index and analyze buttons are disabled when the API is not ready.",
      "steps": [
        {
          "action": "goto",
          "selector": "",
          "value": "/",
          "expected": ""
        },
        {
          "action": "expectVisible",
          "selector": "div.setup-inline",
          "value": "",
          "expected": ""
        },
        {
          "action": "expectText",
          "selector": "div.setup-inline span:nth-child(2)",
          "value": "",
          "expected": "Configure OPENAI_API_KEY and DATABASE_URL to enable reviews. See the setup guide."
        },
        {
          "action": "expectDisabled",
          "selector": "button.index-button",
          "value": "",
          "expected": ""
        },
        {
          "action": "expectDisabled",
          "selector": "button.run-button",
          "value": "",
          "expected": ""
        }
      ]
    }
  ]
}
