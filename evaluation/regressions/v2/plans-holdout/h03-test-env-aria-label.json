      "purpose": "Assert the evaluation section headings and the environment notes input placeholder are as expected pre-change, to catch label changes in the patch.",
      "steps": [
        {
          "action": "goto",
          "selector": "",
          "value": "/",
          "expected": ""
        },
        {
          "action": "expectText",
          "selector": ".evaluation-copy h2",
          "value": "",
          "expected": "BugsJS review baseline"
        },
        {
          "action": "expectText",
          "selector": ".evaluation-copy p",
          "value": "",
          "expected": "30 pre-labeled cases · gpt-4.1-mini · 2026-10-05"
