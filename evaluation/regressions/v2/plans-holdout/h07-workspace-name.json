    {
      "title": "Verify initial workspace label text",
      "purpose": "Ensure the workspace label text shows 'Demo workspace' before patch, indicating correct default workspace naming.",
      "steps": [
        {
          "action": "goto",
          "selector": "",
          "value": "/",
          "expected": ""
        },
        {
          "action": "expectText",
          "selector": ".workspace-copy strong",
          "value": "",
          "expected": "Demo workspace"
        },
        {
          "action": "expectText",
          "selector": ".workspace-copy small",
          "value": "",
          "expected": "Personal plan"
        }
      ]
    },
