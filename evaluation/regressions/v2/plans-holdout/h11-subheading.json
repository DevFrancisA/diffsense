{
  "scenarios": [
    {
      "title": "Verify default heading and description text on Review desk page",
      "purpose": "Ensure that the Review desk page heading and description text match pre-patch content indicating understanding is emphasized.",
      "steps": [
        {
          "action": "goto",
          "selector": "",
          "value": "/",
          "expected": ""
        },
        {
          "action": "expectVisible",
          "selector": "h1",
          "value": "",
          "expected": ""
        },
        {
          "action": "expectText",
          "selector": "h1",
          "value": "",
          "expected": "Review desk"
        },
        {
          "action": "expectText",
          "selector": "section.page-heading > div > div > p",
          "value": "",
          "expected": "Understand the change. Catch what matters."
        }
      ]
    },
    {
