      ]
    },
    {
      "title": "Check API Ready Setup Message Visibility",
      "purpose": "Verify that the setup guide message appears when API is not configured",
      "steps": [
        {
          "action": "goto",
          "selector": "",
          "value": "/",
          "expected": ""
        },
        {
          "action": "expectVisible",
          "selector": ".setup-inline",
          "value": "",
