      "purpose": "Ensure that the precision and recall metrics with context are displayed correctly and separately after the patch fixed the recall metric display issue.",
      "steps": [
        {
          "action": "goto",
          "selector": "",
          "value": "/",
          "expected": ""
        },
        {
          "action": "expectText",
          "selector": ".metric-cell:nth-child(1) strong",
          "value": "",
          "expected": "94.4–100.0%"
        },
        {
          "action": "expectText",
          "selector": ".metric-cell:nth-child(2) strong",
          "value": "",
          "expected": "28.8–30.5%"
        }
      ]
    },
