{
  "scenarios": [
    {
      "title": "Validate Index Repository Context Button Disabled State",
      "purpose": "Ensure the 'Index repository context' button disables and enables correctly based on pull request URL input and API readiness status.",
      "steps": [
        {
          "action": "goto",
          "selector": "",
          "value": "/",
          "expected": ""
        },
        {
          "action": "fill",
          "selector": "#pr-url",
          "value": "",
          "expected": ""
        },
        {
          "action": "expectValueContains",
          "selector": ".index-button",
          "value": "disabled",
          "expected": ""
        },
        {
          "action": "fill",
          "selector": "#pr-url",
          "value": "https://github.com/owner/repo",
          "expected": ""
        },
        {
          "action": "expectValueContains",
          "selector": ".index-button",
          "value": "",
          "expected": ""
        }
      ]
    },
