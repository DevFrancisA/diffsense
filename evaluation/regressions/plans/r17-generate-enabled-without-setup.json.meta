        "title": "Generate Playwright plan button enabled when API not ready but inputs present",
        "purpose": "Verify that the 'Generate Playwright plan' button is enabled even if the API is not ready, as long as there is a diff or pull request URL input present, reflecting the removal of the apiReady condition in the disabled logic.",
        "steps": [
          {
            "action": "goto",
            "selector": "",
            "value": "/",
            "expected": ""
          },
          {
