          "action": "goto",
          "selector": "",
          "value": "/",
          "expected": ""
        },
        {
          "action": "click",
          "selector": "button.button-secondary",
          "value": "",
          "expected": ""
        },
        {
          "action": "expectValue",
          "selector": "textarea[aria-label=\"Unified diff\"]",
          "value": "",
          "expected": ""
        },
        {
          "action": "expectText",
          "selector": ".diff-label-right > span:nth-child(3)",
          "value": "",
          "expected": "11 lines"
        }
      ]
    },
