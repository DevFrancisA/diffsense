{
  "scenarios": [
    {
      "title": "Verify Unified Diff Line Count Decrement",
      "purpose": "Ensure that the displayed unified diff line count correctly subtracts one from the actual lines in the textarea as per the updated UI logic.",
      "steps": [
        {
          "action": "goto",
          "selector": "",
          "value": "/",
          "expected": ""
        },
        {
          "action": "fill",
          "selector": "textarea[aria-label=\"Unified diff\"]",
          "value": "line1\nline2\nline3\n",
          "expected": ""
        },
        {
          "action": "expectText",
          "selector": ".diff-label-right > span:nth-child(3)",
          "value": "",
          "expected": "3 lines"
        }
      ]
    },
    {
