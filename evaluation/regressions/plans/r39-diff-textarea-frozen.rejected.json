{
  "scenarios": [
    {
      "title": "Load example diff disables manual diff editing",
      "purpose": "Verify that after loading the example diff, the unified diff textarea does not accept manual edits",
      "steps": [
        {
          "action": "goto",
          "selector": "",
          "value": "/",
          "expected": ""
        },
        {
          "action": "click",
          "selector": "button.button-secondary:has-text('Load example diff')",
          "value": "",
          "expected": ""
        },
        {
          "action": "fill",
          "selector": "textarea[aria-label='Unified diff']",
          "value": "some text",
          "expected": ""
        },
        {
          "action": "expectValue",
          "selector": "textarea[aria-label='Unified diff']",
          "value": "",
          "expected": ""
        }
      ]
    },
