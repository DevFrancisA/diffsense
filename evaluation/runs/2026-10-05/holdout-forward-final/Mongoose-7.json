        "rawFindings": [
          {
            "title": "_findAndModify does not respect population option when options.lean is true",
            "severity": "high",
            "file": "lib/query.js",
            "line": 2424,
            "explanation": "In the original _findAndModify implementation, if the 'lean' option is true, the promise completes immediately with the raw document and population is skipped, even if population is requested via this.options.populate. This causes the populated fields to not be included in the returned document which breaks expected behavior when population is requested alongside 'lean'.",
            "suggestion": "Modify _findAndModify to check if population is requested (this.options.populate) and perform population accordingly, even if 'lean' is true. If population is not requested, keep the current behavior."
          }
        ],
