        "rawFindings": [
          {
            "title": "SchemaArray now mutates caller-provided `{ type: ... }` definitions",
            "severity": "medium",
            "file": "lib/schema/array.js",
            "line": 42,
            "explanation": "`castOptions` is now assigned the original `cast` object and then `delete castOptions.type` removes the `type` key from the caller's schema definition. Creating a schema with an array path like `{ ids: [{ type: Schema.ObjectId, ref: 'something' }] }` will leave `schema.ids[0].type` missing after `new Schema(schema)`, which can break code that reuses or inspects the original schema object.",
            "suggestion": "Clone `cast` before deleting `type` (for example with `utils.clone(cast)`) so the constructor does not mutate user input.",
            "failureAfterChange": "After `var schema = { ids: [{ type: Schema.ObjectId, ref: 'something' }] }; new Schema(schema);`, `schema.ids[0].type` becomes `undefined` instead of remaining `Schema.ObjectId`.",
            "alreadyFixedByChange": false
          }
        ],
