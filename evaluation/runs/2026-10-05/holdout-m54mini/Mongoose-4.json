        "rawFindings": [
          {
            "title": "Populated subqueries no longer inherit lean from the parent query",
            "severity": "medium",
            "file": "lib/query.js",
            "line": 1636,
            "explanation": "Replacing `preparePopulationOptions(self, options)` with `utils.object.vals(self.options.populate)` stops the code from setting `option.options.lean = true` on populate subqueries. When a caller runs `Model.find().lean().populate('author')`, the root documents are now lean, but the populated `author` query is executed without lean and is hydrated into Mongoose documents instead of plain objects.",
            "suggestion": "Restore propagation of the parent query's lean option to each populate option before executing population, e.g. by keeping `preparePopulationOptions()` or explicitly marking each populate option as lean when `options.lean` is true.",
            "failureAfterChange": "Given a schema with `post.author` populated, `Post.find().lean().populate('author').exec(cb)` returns `post.author` as a Mongoose document with methods like `save()` instead of a plain JavaScript object.",
            "alreadyFixedByChange": false
          }
        ],
        "acceptedFindings": []
      }
    ],
