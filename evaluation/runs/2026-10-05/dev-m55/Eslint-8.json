        "rawFindings": [
          {
            "title": "Line-continuation escapes for Unicode line separators are now reported as useless",
            "severity": "medium",
            "file": "lib/rules/no-useless-escape.js",
            "line": 27,
            "explanation": "This removes U+2028 and U+2029 from the set of valid string escapes. In JavaScript string literals, a backslash followed by any LineTerminator (including U+2028 LINE SEPARATOR and U+2029 PARAGRAPH SEPARATOR) is a line continuation, so the backslash is required. The rule will now incorrectly report these required escapes as unnecessary.",
            "suggestion": "Restore `\\u2028\\u2029` to `VALID_STRING_ESCAPES`, e.g. `new Set(\"\\\\nrvtbfux\\n\\r\\u2028\\u2029\")`.",
            "failureAfterChange": "With `no-useless-escape` enabled, linting `var foo = 'foo \\\u001c bar';` where the character after the backslash is U+2028 reports an unnecessary escape, but removing the backslash would make the string literal invalid rather than equivalent.",
            "alreadyFixedByChange": false
          }
        ],
