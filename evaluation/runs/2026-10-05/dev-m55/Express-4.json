        "rawFindings": [
          {
            "title": "IPv4 hosts are parsed as subdomains",
            "severity": "medium",
            "file": "lib/request.js",
            "line": 457,
            "explanation": "Splitting every host on dots makes an IPv4 address look like domain labels. With the default subdomain offset of 2, `Host: 127.0.0.1` now produces `['0', '127']` for `req.subdomains` even though an IP address has no subdomains.",
            "suggestion": "Restore the IP-address guard, e.g. require `net.isIP` and use `var subdomains = !isIP(host) ? host.split('.').reverse() : [host];` before slicing.",
            "failureAfterChange": "Request with header `Host: 127.0.0.1` and default `subdomain offset` returns `req.subdomains === ['0', '127']` instead of `[]`.",
            "alreadyFixedByChange": false
          }
        ],
