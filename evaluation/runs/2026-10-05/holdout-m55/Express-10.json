          {
            "title": "Root middleware is skipped for URLs without a leading slash",
            "severity": "medium",
            "file": "lib/router/index.js",
            "line": 284,
            "explanation": "The path-boundary check now runs even when `layerPath` is empty (the matched path for `router.use()` mounted at the default `/`). For an empty prefix, checking `path[0]` rejects valid requests whose `req.url` does not start with `/` or `.`, so global middleware is not invoked.",
            "suggestion": "Only perform this separator validation when `layerPath.length !== 0`, or otherwise skip the check for empty `layerPath`.",
            "failureAfterChange": "With `router.use(function (req, res) { res.end() })`, handling `{ url: 'foo', method: 'GET' }` now calls the final `out` callback instead of running the middleware and ending the response.",
            "alreadyFixedByChange": false
          }
