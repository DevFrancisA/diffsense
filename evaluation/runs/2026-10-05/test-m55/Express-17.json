        "rawFindings": [
          {
            "title": "Invalid view engines now produce a generic TypeError",
            "severity": "low",
            "file": "lib/view.js",
            "line": 78,
            "explanation": "This assigns `require(mod).__express` directly without verifying it is a function. For an installed module matching the template extension that does not export `__express` (for example rendering `broken.send`, where the `send` package exists but is not a view engine), Express stores `undefined` as the engine and later calls it in `View.prototype.render`, yielding a generic `TypeError: this.engine is not a function` instead of the intended invalid-engine error.",
            "suggestion": "Restore the local `fn` variable and `typeof fn === 'function'` check before assigning `opts.engines[this.ext]`; throw `Module \"<mod>\" does not provide a view engine.` when invalid.",
            "failureAfterChange": "With an app that calls `res.render('/path/to/broken.send')` and has the `send` package installed, the request now fails with `TypeError: this.engine is not a function` rather than the explicit invalid view engine error.",
            "alreadyFixedByChange": false
          }
        ],
        "acceptedFindings": []
      }
    ],
