        "rawFindings": [
          {
            "title": "Post asset URLs now lose path segments after the post directory",
            "severity": "high",
            "file": "lib/models/post_asset.js",
            "line": 24,
            "explanation": "Using `url.resolve(post.path, this.slug)` treats `this.slug` as a URL-relative reference and can strip the last path segment of `post.path` when the slug does not start with `./` or `../`. For a post at `/foo/bar/` with asset slug `image.png`, the new code returns `/foo/image.png` instead of `/foo/bar/image.png`.",
            "suggestion": "Build the asset path with path joining semantics, e.g. `pathFn.join(post.path, this.slug)`, or normalize `post.path` to a directory URL before resolving.",
            "failureAfterChange": "Given a post whose `path` is `/foo/bar/` and an asset with `slug` `image.png`, the generated asset URL becomes `/foo/image.png`, causing broken links for all post assets nested under the post directory.",
            "alreadyFixedByChange": false
          }
        ],
        "acceptedFindings": []
      }
    ],
