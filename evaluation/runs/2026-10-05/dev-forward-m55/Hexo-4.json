          {
            "title": "Uses OS-specific path joining for URL/public asset paths",
            "severity": "medium",
            "file": "lib/models/post_asset.js",
            "line": 23,
            "explanation": "`pathFn.join` emits platform-specific separators. `PostAsset.path` is consumed as a public path/URL path for post assets, so on Windows this returns backslashes instead of URL separators.",
            "suggestion": "Use a POSIX/URL join that always preserves forward slashes, e.g. `return pathFn.posix.join(post.path, this.slug);` or concatenate with `/` without URL-escaping.",
            "failureAfterChange": "On Windows, for a post with `post.path === 'foo/'` and an asset with `slug === 'bar.png'`, `asset.path` becomes `foo\\bar.png`, causing generated output such as `/foo\\bar.png` instead of `/foo/bar.png`.",
            "alreadyFixedByChange": false
          }
        ],
