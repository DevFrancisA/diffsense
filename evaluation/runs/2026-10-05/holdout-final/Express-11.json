        "rawFindings": [
          {
            "title": "Incorrect handling of numeric body in res.send()",
            "severity": "high",
            "file": "lib/response.js",
            "line": 107,
            "explanation": "The previous code treated a number argument differently based on whether it was a status code or a numeric body with status. The new code unconditionally sets the Content-Type to text/plain and replaces the numeric body with the status message text, converting all numeric bodies to status messages. This removes the ability to send a numeric body as JSON, which breaks expected semantics.",
            "suggestion": "Restore handling allowing res.send(status, num) to send num as JSON, ensuring numeric bodies are sent as JSON and status codes set statusCode without overriding body with status message string."
          }
